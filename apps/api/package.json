{
  "name": "@mana/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the MANÁ business management application.",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate": "node-pg-migrate",
    "migrate:up": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations",
    "migrate:down": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations -j ts"
  }
}
